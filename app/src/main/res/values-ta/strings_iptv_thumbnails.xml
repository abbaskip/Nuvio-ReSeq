    <string name="playback_section_seek_thumbnails">முன்னும் பின்னும் நகர்த்தும்போது சிறுபடங்கள்</string>
    <string name="playback_section_seek_thumbnails_desc">காலப்பட்டிக்கு மேலே முன்னோட்டம் காட்டு</string>
    <string name="iptv_thumbs_subtitle">Seekr படங்களைக் காட்டும் அல்லது சாதனத்தில் காணொளியிலிருந்து படங்களை உருவாக்கும்.</string>
    <string name="iptv_thumbs_works_on">திரைப்படங்கள், தொடர்கள், HLS, பதிவுகள், விளையாட்டு மறுஒளிபரப்புகள், முந்தைய நிகழ்ச்சிகள் மற்றும் நேரலைப் பின்னகர்த்தலுக்கு உதவும். முந்தைய நிகழ்ச்சிகளுக்குச் சேமித்த பகுதி அல்லது வழங்குநரின் HLS பயன்படுத்தப்படும். டொரண்ட், DASH மற்றும் பாதுகாக்கப்பட்ட ஒளிபரப்புகள் ஆதரிக்கப்படாது.</string>
    <string name="iptv_thumbs_low_memory_note">நினைவகம் குறைவு. இயக்கம் தடைப்பட்டால் சிறுபட உருவாக்கம் தானாக இடைநிறுத்தப்படும்.</string>
    <string name="iptv_thumbs_include_4k">4K மற்றும் HDR சேர்க்கவும்</string>
    <string name="iptv_thumbs_include_4k_desc">கூடுதல் தரவு தேவை. திறன் குறைந்த சாதனங்களில் இயக்கம் தடைப்படலாம். HDR நிறங்கள் மங்கலாகத் தோன்றலாம். ஒளிபரப்பில் சிறிய பதிப்பு பயன்படுத்தப்படும்.</string>
    <string name="iptv_thumbs_when_to_make">சிறுபடங்களை எப்போது உருவாக்க வேண்டும்?</string>
    <string name="iptv_thumbs_when_seeking">இடைநிறுத்தும்போது அல்லது நகர்த்தும்போது மட்டும்</string>
    <string name="iptv_thumbs_when_seeking_desc">வழக்கமான இயக்கத்தின்போது படங்கள் உருவாகாது.</string>
