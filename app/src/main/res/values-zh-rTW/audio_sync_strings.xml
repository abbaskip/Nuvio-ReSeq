<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="audio_sync_setting_title">將字幕同步到音訊</string>
    <string name="audio_sync_setting_description">當自動同步找不到可靠的匹配時，將字幕與對話對齊。</string>
    <string name="audio_sync_model_title">英語語音模型 (%1$d MB)</string>
    <string name="audio_sync_model_description">可選。識別英文語音並將其與外部英文字幕匹配，以實現更快、更準確的同步。使用更多的 CPU 和記憶體。</string>
    <string name="audio_sync_model_downloading">正在下載... %1$d%%</string>
    <string name="audio_sync_model_ready">已下載。如果播放速度變慢，請刪除模型以單獨使用語音偵測。</string>
    <string name="audio_sync_model_failed">下載失敗。選擇重試。語音檢測仍然有效。</string>
    <string name="audio_sync_model_download">下載</string>
    <string name="audio_sync_model_delete">刪除</string>
    <string name="audio_sync_sampling_title">音頻採樣</string>
    <string name="audio_sync_sampling_description">在播放之前收聽對話，以便更快找到同步。</string>
    <string name="audio_sync_sampling_off">關閉</string>
    <string name="audio_sync_sampling_low">低</string>
    <string name="audio_sync_sampling_high">高</string>
    <string name="audio_sync_sampling_off_description">僅收聽正在播放的內容，因此同步需要更長的時間。不適用於 mpv 播放器。</string>
    <string name="audio_sync_sampling_low_description">透過一個額外的連接提前收聽一些對話場景，每個標題最多 75 MB。也可以在按流量計費的網路上代替 High 來使用。</string>
    <string name="audio_sync_sampling_high_description">最快的同步。透過多個連線提前收聽更多場景，通常每個標題最多 150 MB，並使用更多 CPU。某些伺服器限制允許的連線數。</string>
    <string name="licenses_attributions_audio_sync_title">音訊字幕同步</string>
    <string name="licenses_attributions_audio_sync_body">語音檢測使用Silero VAD v5權重（MIT，Silero Team）。可選的語音辨識使用sherpa-onnx（Apache-2.0，k2-fsa）及其Zipformer GigaSpeech英語模型（Apache-2.0）。完整的通知隨應用程式一起發佈在 licenses/audio_sync_NOTICE.md 中。</string>
</resources>
