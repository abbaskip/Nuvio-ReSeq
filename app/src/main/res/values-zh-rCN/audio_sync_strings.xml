<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="audio_sync_setting_title">将字幕同步到音频</string>
    <string name="audio_sync_setting_description">当自动同步找不到可靠的匹配时，将字幕与对话对齐。</string>
    <string name="audio_sync_model_title">英语语音模型 (%1$d MB)</string>
    <string name="audio_sync_model_description">可选。识别英文语音并将其与外部英文字幕匹配，以实现更快、更准确的同步。使用更多的 CPU 和内存。</string>
    <string name="audio_sync_model_downloading">正在下载... %1$d%%</string>
    <string name="audio_sync_model_ready">已下载。如果播放速度变慢，请删除模型以单独使用语音检测。</string>
    <string name="audio_sync_model_failed">下载失败。选择重试。语音检测仍然有效。</string>
    <string name="audio_sync_model_download">下载</string>
    <string name="audio_sync_model_delete">删除</string>
    <string name="audio_sync_sampling_title">音频采样</string>
    <string name="audio_sync_sampling_description">在播放之前收听对话，以便更快地找到同步。</string>
    <string name="audio_sync_sampling_off">关闭</string>
    <string name="audio_sync_sampling_low">低</string>
    <string name="audio_sync_sampling_high">高</string>
    <string name="audio_sync_sampling_off_description">仅收听正在播放的内容，因此同步需要更长的时间。不适用于 mpv 播放器。</string>
    <string name="audio_sync_sampling_low_description">通过一个额外的连接提前收听一些对话场景，每个标题最多 75 MB。也可以在按流量计费的网络上代替 High 来使用。</string>
    <string name="audio_sync_sampling_high_description">最快的同步。通过多个连接提前收听更多场景，通常每个标题最多 150 MB，并使用更多 CPU。某些服务器限制允许的连接数。</string>
    <string name="licenses_attributions_audio_sync_title">音频字幕同步</string>
    <string name="licenses_attributions_audio_sync_body">语音检测使用Silero VAD v5权重（MIT，Silero Team）。可选的语音识别使用sherpa-onnx（Apache-2.0，k2-fsa）及其Zipformer GigaSpeech英语模型（Apache-2.0）。完整的通知随应用程序一起发布在 licenses/audio_sync_NOTICE.md 中。</string>
</resources>
